  "components": {
    "schemas": {
      "Body_token_v1_oauth_token_post": {
        "properties": {
          "grant_type": {
            "type": "string",
            "pattern": "^client_credentials$",
            "title": "Grant Type"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "client_secret": {
            "type": "string",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "grant_type",
          "client_id",
          "client_secret"
        ],
        "title": "Body_token_v1_oauth_token_post"
      },
      "Device": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Device Id",
            "examples": [
              "watch-001"
            ]
          },
          "model": {
            "type": "string",
            "maxLength": 64,
            "title": "Model",
            "examples": [
              "StressBand S1"
            ]
          },
          "firmware_version": {
            "type": "string",
            "maxLength": 32,
            "title": "Firmware Version",
            "examples": [
              "1.4.2"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "model",
          "firmware_version",
          "created_at"
        ],
        "title": "Device"
      },
      "DeviceCreate": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Device Id",
            "examples": [
              "watch-001"
            ]
          },
          "model": {
            "type": "string",
            "maxLength": 64,
            "title": "Model",
            "examples": [
              "StressBand S1"
            ]
          },
          "firmware_version": {
            "type": "string",
            "maxLength": 32,
            "title": "Firmware Version",
            "examples": [
              "1.4.2"
            ]
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "model",
          "firmware_version"
        ],
        "title": "DeviceCreate"
      },
      "DeviceUpdate": {
        "properties": {
          "firmware_version": {
            "type": "string",
            "maxLength": 32,
            "title": "Firmware Version",
            "examples": [
              "1.5.0"
            ]
          }
        },
        "type": "object",
        "required": [
          "firmware_version"
        ],
        "title": "DeviceUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "description": "RFC 9457 problem details, returned for every error as application/problem+json."
      },
      "ResultsPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WindowResult"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ResultsPage"
      },
      "StressLabel": {
        "type": "string",
        "enum": [
          "stressed",
          "not_stressed",
          "na"
        ],
        "title": "StressLabel"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Seconds until the token expires."
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "scope"
        ],
        "title": "TokenResponse"
      },
      "Upload": {
        "properties": {
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "sample_rate_hz": {
            "type": "integer",
            "title": "Sample Rate Hz"
          },
          "duration_s": {
            "type": "integer",
            "title": "Duration S"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "firmware_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware Version",
            "description": "Device firmware when the upload was created, for traceability."
          },
          "window_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Count"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "device_id",
          "status",
          "started_at",
          "sample_rate_hz",
          "duration_s",
          "created_at"
        ],
        "title": "Upload"
      },
      "UploadCreate": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Device Id"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At",
            "description": "Wall-clock time of the first sample (UTC)."
          },
          "sample_rate_hz": {
            "type": "integer",
            "maximum": 512.0,
            "minimum": 1.0,
            "title": "Sample Rate Hz",
            "examples": [
              25
            ]
          },
          "duration_s": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 60.0,
            "title": "Duration S",
            "description": "At least one 60 s window."
          },
          "content_type": {
            "type": "string",
            "pattern": "^application/json$",
            "title": "Content Type",
            "default": "application/json"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "started_at",
          "sample_rate_hz",
          "duration_s"
        ],
        "title": "UploadCreate"
      },
      "UploadStatus": {
        "type": "string",
        "enum": [
          "pending_upload",
          "processing",
          "processed",
          "failed"
        ],
        "title": "UploadStatus"
      },
      "UploadTicket": {
        "properties": {
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "sample_rate_hz": {
            "type": "integer",
            "title": "Sample Rate Hz"
          },
          "duration_s": {
            "type": "integer",
            "title": "Duration S"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "firmware_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware Version",
            "description": "Device firmware when the upload was created, for traceability."
          },
          "window_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Count"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "upload_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Url",
            "description": "Pre-signed PUT URL. No Authorization header needed. Null on a replay once the file has arrived."
          },
          "upload_url_expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Url Expires At"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "device_id",
          "status",
          "started_at",
          "sample_rate_hz",
          "duration_s",
          "created_at",
          "upload_url",
          "upload_url_expires_at"
        ],
        "title": "UploadTicket"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WindowResult": {
        "properties": {
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "window_start": {
            "type": "string",
            "format": "date-time",
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "format": "date-time",
            "title": "Window End"
          },
          "label": {
