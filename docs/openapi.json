          },
          "heart_rate_bpm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heart Rate Bpm"
          },
          "signal_quality": {
            "type": "string",
            "title": "Signal Quality",
            "examples": [
              "good",
              "motion",
              "poor_signal"
            ]
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "upload_id",
          "window_start",
          "window_end",
          "label",
          "heart_rate_bpm",
          "signal_quality",
          "model_version"
        ],
        "title": "WindowResult"
      }
    },
    "securitySchemes": {
