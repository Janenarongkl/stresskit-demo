    "/v1/results": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "List Results",
        "description": "Latest windows for a device, oldest first.",
        "operationId": "list_results_v1_results_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "required": true,
